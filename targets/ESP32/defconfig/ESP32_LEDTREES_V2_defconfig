# defconfig for ESP32_LEDTREES_V2
# Based on ESP32_S3_OCTAL_defconfig, matching the former ESP32_S3 base preset:
# OneWire / I2C-slave APIs removed; BLE disabled (frees RAM/flash, no Wi-Fi coex)

CONFIG_API_HARDWARE_ESP32=y
CONFIG_API_SYSTEM_DEVICE_ADC=y
CONFIG_API_SYSTEM_DEVICE_GPIO=y
CONFIG_API_SYSTEM_DEVICE_I2C=y
CONFIG_API_SYSTEM_DEVICE_I2S=y
CONFIG_API_SYSTEM_DEVICE_PWM=y
CONFIG_API_SYSTEM_DEVICE_SPI=y
CONFIG_API_SYSTEM_DEVICE_WIFI=y
CONFIG_API_SYSTEM_IO_FILESYSTEM=y
CONFIG_API_SYSTEM_IO_PORTS=y
CONFIG_API_SYSTEM_MATH=y
CONFIG_API_SYSTEM_NET=y
# CONFIG_API_NANOFRAMEWORK_DEVICE_BLUETOOTH is not set
CONFIG_API_NANOFRAMEWORK_HARDWARE_ESP32_RMT=y
CONFIG_API_NANOFRAMEWORK_RESOURCEMANAGER=y
CONFIG_API_NANOFRAMEWORK_SYSTEM_COLLECTIONS=y
CONFIG_API_NANOFRAMEWORK_SYSTEM_IO_HASHING=y
CONFIG_API_NANOFRAMEWORK_SYSTEM_SECURITY_CRYPTOGRAPHY=y
CONFIG_API_NANOFRAMEWORK_SYSTEM_TEXT=y
CONFIG_ESP32_RESERVE_SPIRAM_IDF_ALLOCATION_BYTES=1048576
CONFIG_NF_WP_TRANSPORT_USB_CDC_OR_SERIAL=y
# NF_BUILD_RTM здесь не задаётся: он выводится из CMAKE_BUILD_TYPE
# (Release/MinSizeRel -> RTM, Debug -> отладчик CLR), см. NF_Kconfig.cmake
# LEDTREES: остаётся y вынужденно - ESP32-платформа линкует NF_Debugger и
# wire-protocol-объекты безусловно (binutils.ESP32.cmake:374,973 + прямые
# объекты в elf), с OFF сборка не сходится. Деплой managed-кода по USB
# (nanoff --deploy в обход подписи OTA) закрыт иначе: из RTM-таблицы команд
# (src/CLR/Debugger/Debugger_minimal.cpp) вырезаны WriteMemory/EraseMemory/
# Execute. Сам wire protocol жив - он нужен доставке рецепта раздачи
# (HaltedFileDeploy: pause/resume + StorageOperation).
CONFIG_NF_FEATURE_DEBUGGER=y
CONFIG_NF_FEATURE_HAS_ACCESSIBLE_STORAGE=y
CONFIG_NF_FEATURE_HAS_CONFIG_BLOCK=y
CONFIG_NF_FEATURE_HAS_SDCARD=y
CONFIG_NF_FEATURE_RTC=y
CONFIG_NF_FEATURE_USE_LITTLEFS=y
CONFIG_NF_FEATURE_OTA=y
# CONFIG_NF_CLR_NO_TRACE is not set
# CONFIG_NF_TARGET_HAS_NANOBOOTER is not set
CONFIG_RTOS_ESP32=y
CONFIG_SDK_CONFIG_FILE="sdkconfig.default_lt_v2.esp32s3"
CONFIG_NF_SUPPORT_ANY_BASE_CONVERSION=y
CONFIG_TARGET_BOARD="ESP32_S3"
CONFIG_TARGET_SERIES="ESP32_S3"
