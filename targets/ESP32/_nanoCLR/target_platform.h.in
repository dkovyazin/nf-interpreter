#ifndef TARGET_PLATFORM_H
#define TARGET_PLATFORM_H

#define NANOCLR_GRAPHICS                      @NANOCLR_GRAPHICS@
#define ESP32_RESERVE_SPIRAM_IDF_ALLOCATION_BYTES @ESP32_RESERVE_SPIRAM_IDF_ALLOCATION_BYTES@
#define ESP32_RESERVE_IRAM_IDF_ALLOCATION_KB      @ESP32_RESERVE_IRAM_IDF_ALLOCATION_KB@
#define HAL_USE_SPI                           @HAL_USE_SPI_OPTION@
#define HAL_USE_UART                          @HAL_USE_UART_OPTION@
#define HAL_USE_SDC                           @HAL_USE_SDC_OPTION@
#define HAL_USE_BLE                           @HAL_USE_BLE_OPTION@

#define HAL_USE_THREAD                        @HAL_USE_THREAD_OPTION@

enum esp_threadRoles{ FTD, MED, SED};
#define THREAD_NODE_ROLE                      @THREAD_NODE_ROLE@ 

enum nf_openThreadModes{ NATIVE, SPI, UART};
#define THREAD_RADIO_MODE                     @THREAD_RADIO_MODE@
// UART or SPI parameters (currently not used, WIP)
#define THREAD_RCP_PARAMS                     @THREAD_RCP_PARAMS@
// DatasetTLVS to use for Auto connect
#define THREAD_DATASETTLVS                    "@THREAD_DATASETTLVS@"

#if (HAL_USE_SDC == TRUE)
// LEDTREES: 5 -> 16. Бюджет одновременно открытых файлов SD на MAIN:
// кэш играющей программы держится открытым ВСЁ воспроизведение (+1 постоянно),
// подготовка кэша (+2: tmp и frames.dat), раздача DownloadService — по файлу
// на воркера (MaxConcurrentDownloads = 10 — уже больше прежнего лимита),
// web-статика админки (+1 на запрос). С лимитом 5 File.OpenRead статики
// падал 500-кой во время воспроизведения. Цена ~600 байт RAM на дескриптор.
#define SDC_MAX_OPEN_FILES 16
#endif

#endif // TARGET_PLATFORM_H
