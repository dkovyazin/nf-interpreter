# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF)  Project Minimal Configuration
#
CONFIG_IDF_CMAKE=y
CONFIG_IDF_TARGET_ARCH_XTENSA=y
CONFIG_IDF_TARGET="esp32s3"

CONFIG_SOC_SDMMC_HOST_SUPPORTED=y

# Deprecated drivers, disable warnings on build
CONFIG_ADC_SUPPRESS_DEPRECATE_WARN=y
CONFIG_ADC_CALI_SUPPRESS_DEPRECATE_WARN=y
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_PCNT_SUPPRESS_DEPRECATE_WARN=y
CONFIG_I2S_SUPPRESS_DEPRECATE_WARN=y
CONFIG_TOUCH_SUPPRESS_DEPRECATE_WARN=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=y
# LEDTREES: QIO instead of DIO - 4 data lines to the flash instead of 2, so
# cache misses (executing code from flash) are served about twice as fast.
# Only takes effect when flashing over the wire: the mode is set by the
# bootloader, and OTA does not update it.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_STR=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"

# LEDTREES: firmware signing without hardware Secure Boot (the eFuses are left
# alone). The build signs nanoCLR.bin with an RSA-3072 key
# (secure_boot_signing_key.pem in the repository root, NOT in git - losing the
# key means no more OTA releases). During an OTA, esp_ota_end() rejects an image
# that is not signed with the same key as the running firmware
# (NF_Ota_FirmwareEnd returns false). Flashing over USB (esptool) still accepts
# anything: without eFuse Secure Boot the bootloader does not verify the
# signature, a deliberate "stage 1" compromise. Managed deployment over the wire
# protocol is closed off separately (Debugger_minimal.cpp, RTM builds only -
# Debug builds with the full debugger are not affected).
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key.pem"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="targets/ESP32/_IDF/esp32s3/partitions_nanoclr_16mb_ota.csv"
# OTA: new firmware boots as PENDING_VERIFY; rolls back unless confirmed (NF_FEATURE_OTA)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# LEDTREES: post-mortem dump of a native panic into the coredump partition
# (48k, docs/telemetry.md). The managed log ring (LogRing) does not survive a
# panic - by then the CLR is no longer executing, and the stack of the native
# task is visible ONLY from here. The admin UI fetches the dump with
# GET /coredump.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# ELF rather than the binary format: the binary one can only be parsed by a
# matching version of espcoredump.py, while ELF is read by a stock gdb or
# idf.py coredump-info against the build's .elf
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_SHA256=y
# Integrity check on boot: the managed side asks whether a dump is present and
# must get an answer about a COMPLETE dump, not about rubbish in an erased
# partition
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
# 16 tasks instead of 64: a dump with fifty odd stacks does not fit into a 48k
# partition, and there is no need for it - a panic happens in one task and the
# rest are only of interest as context. A dump that does not fit is not written
# by IDF at all.
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16
# .bss, .data and the heap are NOT taken into the dump in full: that would be
# megabytes against a 48k partition
# CONFIG_ESP_COREDUMP_CAPTURE_DRAM is not set
# A new panic overwrites the old dump: the last death is what matters, while
# "the first one since flashing" is almost always stale by then
# CONFIG_ESP_COREDUMP_FLASH_NO_OVERWRITE is not set

# LEDTREES: -O2 instead of the upstream -Os for the IDF components (lwIP, Wi-Fi,
# FreeRTOS, drivers), at the cost of a larger firmware image (keep an eye on the
# OTA slot). This flag does NOT affect the nanoFramework libraries (the CLR
# interpreter and interop) - those are built with the CMAKE_BUILD_TYPE flags, and
# their -O2 is set separately in binutils.ESP32.cmake
# Removes build timestamps and absolute paths from the image: identical sources
# produce an identical UNSIGNED image. It does not make the finished image byte
# for byte identical - the RSA-PSS signature takes a random salt - but it makes a
# build cache in CI meaningful: the key is computed over the inputs, and on a hit
# a previously built artefact is reused instead of building again.
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# LEDTREES: PM is off (upstream enables it): the device is not battery powered,
# DFS was never activated anyway (nobody calls esp_pm_configure), and the PM
# locks in the drivers plus tickless idle only add overhead and jitter
# CONFIG_PM_ENABLE is not set

#
# ESP PSRAM
#
CONFIG_SPIRAM=y

#
# SPI RAM config
#
# CONFIG_SPIRAM_MODE_QUAD is not set
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
# CONFIG_SPIRAM_TYPE_ESPPSRAM64 is not set
# formerly CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY (renamed in IDF)
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
# CONFIG_SPIRAM_FETCH_INSTRUCTIONS is not set
# CONFIG_SPIRAM_RODATA is not set
CONFIG_SPIRAM_SPEED_80M=y
# CONFIG_SPIRAM_SPEED_40M is not set
CONFIG_SPIRAM_SPEED=80
# CONFIG_SPIRAM_ECC_ENABLE is not set
CONFIG_SPIRAM_BOOT_INIT=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
# CONFIG_SPIRAM_USE_MEMMAP is not set
# CONFIG_SPIRAM_USE_CAPS_ALLOC is not set
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set
# end of SPI RAM config
# end of ESP PSRAM


CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# LEDTREES: caches larger than the default (I-cache 16K, D-cache 32K) - fewer
# misses on the large CLR code and on PSRAM access, at the cost of 48 KB of
# internal SRAM
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
# LEDTREES: a 64 byte D-cache line instead of 32 - higher throughput on the
# octal PSRAM (the frames and the managed heap live there): twice as much is
# pulled in per miss, so the per transaction overhead is amortised
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_ESP_TASK_WDT_INIT=n

CONFIG_ESP_IPC_TASK_STACK_SIZE=1024

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
# LEDTREES: a block-ack window of 16 instead of 6 - when the air is lossy a
# narrow window strangles AMPDU aggregation (the receiver cannot reorder the tail
# of a burst); the Espressif recommendation for throughput is about half of
# DYNAMIC_RX_BUFFER_NUM (32). The cost is internal RAM for the buffers, and only
# under load
CONFIG_ESP_WIFI_RX_BA_WIN=16

CONFIG_FATFS_LFN_HEAP=y

CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2304
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=5

CONFIG_LOG_DEFAULT_LEVEL_NONE=y

CONFIG_LWIP_LOCAL_HOSTNAME="nanodevice"
CONFIG_LWIP_MAX_SOCKETS=30
CONFIG_LWIP_SO_LINGER=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_DHCP_OPTIONS_LEN=80
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_DHCPS_LEASE_UNIT=60
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=8
CONFIG_LWIP_DHCPS_STATIC_ENTRIES=y
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_MAX_LISTENING_TCP=8
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# LEDTREES: TCP throughput for serving programs and OTA (port 44000). The
# default send window and buffer of 5760 (4xMSS) capped TCP at about window/RTT
# (0.6-1 MB/s) regardless of link quality; 31680 (22xMSS) roughly doubles the
# ceiling at the cost of about 12 KB of RAM per socket. The lwIP IRAM
# optimisation adds another 10-20% at the cost of IRAM (the Wi-Fi IRAM options
# are already on by IDF default).
CONFIG_LWIP_TCP_WND_DEFAULT=31680
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=31680
CONFIG_LWIP_IRAM_OPTIMIZATION=y
# LEDTREES: mailbox queues modelled on the P4 preset - the default TCP recvmbox
# (6) dropped the rate on bursts, with segments waiting for a slot in the queue
# at full speed
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
# LEDTREES: SACK - when a segment is lost only the hole is retransmitted rather
# than the whole tail of the window; Wi-Fi always loses packets, and serving
# programs over TCP with large windows (the 22xMSS above) pays a whole window for
# every loss without SACK
CONFIG_LWIP_TCP_SACK_OUT=y
# LEDTREES: tcpip is pinned to core 0, together with the rest of the network
# stack. The CLR now runs on core 1 (esp32s3/app_main.c), and an unpinned tcpip
# (the IDF default) is exactly where the scheduler would push it - onto the
# least busy core
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_DES_C=y
CONFIG_MBEDTLS_XTEA_C=n
CONFIG_MBEDTLS_PEM_WRITE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=y
CONFIG_MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_EPHEMERAL=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK_EPHEMERAL=y
CONFIG_MBEDTLS_SSL_ALPN=y

CONFIG_LITTLEFS_MAX_PARTITIONS=1
CONFIG_LITTLEFS_OBJ_NAME_LEN=256
CONFIG_LITTLEFS_OPEN_DIR=y
CONFIG_LITTLEFS_FCNTL_GET_PATH=y

# Hand-tuned settings carried over from the release-branch sdkconfig
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
CONFIG_ESP_TIMER_ISR_AFFINITY_CPU0=y
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_LOG_COLORS=y
# Suspending a flash erase or write when XIP needs the bus: without it, erasing
# a sector freezes execution from flash for tens of milliseconds, and a streaming
# OTA install stutters the LED animation for the whole transfer. Requires a chip
# with suspend/resume support - on a chip without it, IDF simply does not enable
# the mechanism.
CONFIG_SPI_FLASH_AUTO_SUSPEND=y
